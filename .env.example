# Backend only. Never put these values in Swift source or the Pages website.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CORAL_ENCRYPTION_KEY=
CORAL_PUBLIC_URL=https://coral-api.example.com
CORAL_WEB_URL=https://YOUR_ACCOUNT.github.io/Coral
CORAL_DATABASE=/data/coral.sqlite
GITHUB_OAUTH_SCOPES=codespace
CORAL_DEMO=0

