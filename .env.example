# Backend only. Never put these values in Swift source or the Pages website.
# Set the password for /admin on the backend, then enter the GitHub OAuth pair there.
CORAL_ADMIN_PASSWORD=
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CORAL_ENCRYPTION_KEY=
# Render supplies the service URL. Set this to use a custom domain or another host.
# CORAL_PUBLIC_URL=https://coral-api.example.com
CORAL_WEB_URL=https://YOUR_ACCOUNT.github.io/Coral
CORAL_DATABASE=/data/coral.sqlite
# Supabase Session pooler connection URI for hosted PostgreSQL storage.
# CORAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
GITHUB_OAUTH_SCOPES=codespace
CORAL_DEMO=0

# For a Render Free Web Service, use an external PostgreSQL database and scheduler.
# CORAL_HOSTING_MODE=render-free
# CORAL_SCHEDULER_TOKEN=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
